[mysqld]
# Gazelle's schema and queries predate MySQL strict mode (zero dates, implicit
# defaults, etc.), so disable it.
sql_mode =
innodb_strict_mode = 0

character-set-server = utf8
collation-server = utf8_swedish_ci

# Tuned small for a 1 GB host.
innodb_buffer_pool_size = 128M
max_allowed_packet = 64M
max_connections = 50
performance_schema = OFF
