# Copy to .env and fill in. The DB passwords and tracker keys must match
# classes/config.php (SQLPASS, TRACKER_SECRET, TRACKER_REPORTKEY).
MARIADB_ROOT_PASSWORD=change-me-root
GAZELLE_DB_USER=gazelle
GAZELLE_DB_PASSWORD=change-me-db

# Must be exactly 32 characters each (e.g. `openssl rand -hex 16`).
TRACKER_SECRET=00000000000000000000000000000000
TRACKER_REPORTKEY=00000000000000000000000000000000
